        "data": {
          "title": "1. Introduction",
          "body": [
            {
              "_type": "block",
              "_key": "policy-introduction-en",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "policy-introduction-en-span",
                  "text": "HH Publisher is committed to advancing scholarly communication by providing a trusted, ethical, transparent, and accessible platform for the dissemination of high-quality academic and scientific research.",
                  "marks": []
                }
              ]
            }
          ],
          "sort_order": 1
        }
      },
      {
        "id": "policy-editorial-independence-en",
        "status": "published",
        "locale": "en",
        "data": {
          "title": "2. Editorial Independence",
          "body": [
            {
              "_type": "block",
              "_key": "policy-editorial-independence-en",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "policy-editorial-independence-en-span",
                  "text": "HH Publisher recognises the importance of editorial independence in maintaining the integrity and credibility of scholarly publishing. Editorial decisions shall be based primarily on scientific quality, originality, and relevance.",
                  "marks": []
                }
              ]
            }
          ],
          "sort_order": 2
        }
      },
      {
        "id": "policy-introduction-bm",
