        "id": "home-en",
        "slug": "home",
        "status": "published",
        "locale": "en",
        "data": {
          "hero_eyebrow": "Est. 2017 · Malaysia",
          "hero_title": "Upholding the Integrity of Knowledge & Research",
          "hero_description": "An international journal publishing company established in 2017. We invite all scholars from any background all over the world to collaborate with us without prejudice.",
          "hero_cta": "Explore Journals",
          "hero_image": {
            "$media": {
              "url": "https://raw.githubusercontent.com/fadlisaad/hh-publisher/03a0768cd0fb95c438319f08da687dd8218da665/src/assets/images/hero_academic_publisher_1790832085983.jpg",
              "filename": "hero-academic-publisher.jpg",
              "alt": "HH Publisher Editorial Office"
            }
          },
          "hero_quote": "Trusted partnership for the advancement of modern civilization.",
          "why_title": "Why Choose HH Publisher",
          "why_intro": "We are not merely a publisher; we value the meaning of trusted partnership.",
          "features": [
            { "title": "Double-Blind Review", "description": "Rigorous peer review systems ensure completely unbiased feedback and academic integrity." },
            { "title": "Gold Open Access", "description": "Immediate discoverability worldwide without paywall restrictions, ensuring global visibility." },
            { "title": "Inclusive Research", "description": "Supporting researchers from diverse backgrounds with a fair, prejudice-free global stage." },
            { "title": "Institutional Grounding", "description": "Based in Malaysia with transparent affiliation and physical operational offices." }
          ],
          "journals_intro": "Our portfolio covers emerging fields from microbes and molecular biology to agricultural economics.",
          "about_intro": "HH Publisher is a brand of HH Academic; registered under the Companies Commission of Malaysia in 2017. HH Publisher is committed to supporting the advancement and dissemination of high-quality scholarly research across a broad range of academic disciplines.",
          "about_mission": "Our mission is to provide a reliable platform for researchers, academics, and professionals to share original research, innovative ideas, and knowledge that contribute to scientific and societal development.",
          "mission_quote": "To provide a reliable platform for researchers, academics, and professionals to share original research and innovative ideas.",
          "policies_intro": "HH Publisher follows internationally recognised principles of publication ethics (COPE).",
          "core_principles": [
            { "label": "Anti-Plagiarism Screening" },
            { "label": "Conflict of Interest Disclosure" },
            { "label": "Informed Consent Protocols" },
            { "label": "Post-Publication Corrections" }
          ],
          "contact_intro": "We are always open to new collaborations and inquiries from the global scholarly community.",
          "phone": "+60 12-359 0809",
          "email": "inquiries@hh-publisher.com",
          "address": "G-04 Lake Villa Apartment,\nJalan Taman Bandar Senawang 4, Taman Bandar Senawang,\n70450 Seremban, Negeri Sembilan, Malaysia",
          "footer_tagline": "Building Success & Bridging Partnership"
        }
      },
      {
        "id": "home-bm",
        "slug": "home",
        "status": "published",
        "locale": "bm",
        "translationOf": "home-en",
        "data": {
          "hero_eyebrow": "Ditubuhkan 2017 · Malaysia",
          "hero_title": "Memartabatkan Integriti Ilmu & Penyelidikan",
          "hero_description": "Syarikat penerbitan jurnal antarabangsa yang ditubuhkan pada 2017. Kami menjemput semua sarjana dari pelbagai latar belakang di seluruh dunia untuk bekerjasama dengan kami tanpa prejudis.",
          "hero_cta": "Teroka Jurnal",
          "hero_image": {
            "$media": {
              "url": "https://raw.githubusercontent.com/fadlisaad/hh-publisher/03a0768cd0fb95c438319f08da687dd8218da665/src/assets/images/hero_academic_publisher_1790832085983.jpg",
              "filename": "hero-academic-publisher.jpg",
              "alt": "Pejabat Editorial HH Publisher"
            }
          },
          "hero_quote": "Kerjasama dipercayai untuk kemajuan tamadun moden.",
          "why_title": "Kenapa Memilih HH Publisher",
          "why_intro": "Kami bukan sekadar penerbit; kami menghargai makna perkongsian yang dipercayai.",
          "features": [
            { "title": "Ulasan Dwi-Buta", "description": "Sistem ulasan rakan sebaya yang ketat memastikan maklum balas yang saksama dan integriti akademik." },
            { "title": "Akses Terbuka Emas", "description": "Kebolehan untuk ditemui dengan segera di seluruh dunia tanpa sekatan dinding bayaran." },
            { "title": "Penyelidikan Inklusif", "description": "Menyokong penyelidik dari pelbagai latar belakang dengan pentas global yang adil dan bebas prejudis." },
            { "title": "Asas Institusi", "description": "Berpangkalan di Malaysia dengan gabungan yang telus dan pejabat operasi fizikal." }
          ],
          "journals_intro": "Portfolio kami merangkumi bidang baharu daripada mikrob dan biologi molekul hingga ekonomi pertanian.",
          "about_intro": "HH Publisher adalah jenama di bawah HH Academic; berdaftar di bawah Suruhanjaya Syarikat Malaysia pada 2017. HH Publisher komited untuk menyokong kemajuan dan penyebaran penyelidikan ilmiah berkualiti tinggi merentasi pelbagai disiplin akademik.",
          "about_mission": "Misi kami adalah untuk menyediakan platform yang boleh dipercayai bagi penyelidik, ahli akademik, dan profesional untuk berkongsi penyelidikan asli, idea inovatif, dan pengetahuan yang menyumbang kepada pembangunan saintifik dan masyarakat.",
          "mission_quote": "Untuk menyediakan platform yang boleh dipercayai bagi penyelidik, ahli akademik, dan profesional untuk berkongsi penyelidikan asli dan idea inovatif.",
          "policies_intro": "HH Publisher mematuhi prinsip etika penerbitan yang diiktiraf di peringkat antarabangsa (COPE).",
          "core_principles": [
            { "label": "Penyaringan Anti-Plagiat" },
            { "label": "Pendedahan Konflik Kepentingan" },
            { "label": "Protokol Keizinan Termaklum" },
            { "label": "Pembetulan Selepas Penerbitan" }
          ],
          "contact_intro": "Kami sentiasa terbuka kepada kerjasama dan pertanyaan baharu daripada komuniti ilmiah global.",
          "phone": "+60 12-359 0809",
          "email": "inquiries@hh-publisher.com",
          "address": "G-04 Lake Villa Apartment,\nJalan Taman Bandar Senawang 4, Taman Bandar Senawang,\n70450 Seremban, Negeri Sembilan, Malaysia",
          "footer_tagline": "Building Success & Bridging Partnership"
        }
      }
