{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hh-publisher",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hh-publisher",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hh-publisher-media",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
}
