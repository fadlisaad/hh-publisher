---
import { Image } from 'emdash/ui';
import type { ImageValue } from 'emdash';
import { getLocalizedCollection } from '../lib/content';
import { content, type EditorialMember, type Language } from '../content/store';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = content[lang];
const result = await getLocalizedCollection('editorial_board', lang);
if (result.error) {
  Astro.response.status = 500;
  throw result.error;
}
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const editorialBoard = result.entries as Array<{ data: EditorialMember }>;
---

<section id="editorial-board" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-5xl font-serif text-stone-900">
        {t.editorial.title.split(' ')[0]} <span class="text-primary">{t.editorial.title.split(' ').slice(1).join(' ')}</span>
      </h2>
      <p class="text-stone-500 max-w-2xl mx-auto text-lg font-medium">
        {t.editorial.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {editorialBoard.map(({ data: member }) => (
        <div class="group relative bg-stone-50 rounded-2xl overflow-hidden border border-stone-100 hover:border-primary/30 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/5">
          {/* Image Container */}
          <div class="aspect-square overflow-hidden bg-stone-200">
            <Image image={member.photo as ImageValue | undefined} alt={member.name} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" />
          </div>

          {/* Content */}
          <div class="p-6 space-y-4">
            <div>
              <h3 class="text-xl font-serif text-stone-900 group-hover:text-primary transition-colors">
                {member.name}
              </h3>
              <p class="text-[10px] uppercase tracking-[0.2em] text-primary font-bold mt-1">
                {member.role}
              </p>
            </div>

            <p class="text-xs text-stone-500 font-semibold leading-relaxed">
              {member.institution}
            </p>

            <div class="pt-2 flex flex-wrap gap-2">
              {(member.focus ?? []).map(({ area }) => (
                <span class="text-[9px] px-2 py-1 bg-stone-100 text-stone-600 rounded-md border border-stone-200 uppercase tracking-wider group-hover:bg-primary/10 group-hover:border-primary/20 transition-colors">
                  {area}
                </span>
              ))}
            </div>
          </div>

          {/* Subtle Accent Line */}
          <div class="absolute bottom-0 left-0 w-full h-1 bg-primary scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
        </div>
      ))}
    </div>
  </div>
</section>
