---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found" description="The page you are looking for does not exist." lang="en">
  <section class="min-h-[60vh] flex flex-col items-center justify-center text-center px-6">
    <h1 class="text-9xl font-serif text-stone-200 mb-8">404</h1>
    <h2 class="text-3xl font-serif text-stone-900 mb-4">Page Not Found</h2>
    <p class="text-stone-500 mb-12 max-w-md mx-auto">
      The manuscript you are looking for has either been moved or does not exist in our archives.
    </p>
    <a href="/" class="px-8 py-4 bg-stone-900 text-white rounded-full text-sm font-medium hover:bg-stone-800 transition-all shadow-lg hover:shadow-xl">
      Return Home
    </a>
  </section>
</Layout>
